let
  cudaFast = {
    n-gpu-layers = 999;
    flash-attn = "on";
  };

  hybridCuda = {
    fit = "on";
    flash-attn = "on";
  };

  lowVramMoE = {
    fit = "on";
    flash-attn = "on";
    cache-type-k = "q4_0";
    cache-type-v = "q4_0";
  };

  qwenCoder1_5bInstruct = techStack: {
    # llama-server treats comma-separated aliases as multiple aliases. Keep
    # stack and size readable without commas so every generated preset has one
    # unique router name.
    alias = "Qwen2.5 Coder Instruct [${techStack} 1.5B total]";
    hf-repo = "Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF";
    hf-file = "qwen2.5-coder-1.5b-instruct-q4_k_m.gguf";
    ctx-size = 16384;
    n-predict = 2048;
    temp = "0.2";
    top-p = "0.9";
  } // cudaFast;

  toolchainSlms = builtins.listToAttrs (map
    (techStack: {
      name = "qwen2_5-coder-1_5b-${techStack.slug}";
      value = qwenCoder1_5bInstruct techStack.label;
    }) [
      {
        slug = "android";
        label = "Android";
      }
      {
        slug = "c-cpp";
        label = "C/C++";
      }
      {
        slug = "go";
        label = "Go";
      }
      {
        slug = "java-kotlin";
        label = "Java/Kotlin";
      }
      {
        slug = "javascript-typescript";
        label = "JavaScript/TypeScript";
      }
      {
        slug = "lua";
        label = "Lua";
      }
      {
        slug = "nix";
        label = "Nix";
      }
      {
        slug = "protobuf";
        label = "Protobuf";
      }
      {
        slug = "python";
        label = "Python";
      }
      {
        slug = "rust";
        label = "Rust";
      }
      {
        slug = "topiary";
        label = "Topiary/Nickel/Tree-sitter";
      }
    ]);
in
  {
    gpt-oss-20b-daily-reasoning = {
      alias = "GPT-OSS [Daily Reasoning 21B total 3.6B active]";
      hf-repo = "ggml-org/gpt-oss-20b-GGUF";
      hf-file = "gpt-oss-20b-mxfp4.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "1.0";
      top-p = "1.0";
    } // lowVramMoE;

    qwen3_6-35b-a3b-quality-coding = {
      alias = "Qwen3.6 [Quality Coding 35B total 3B active]";
      hf-repo = "unsloth/Qwen3.6-35B-A3B-GGUF";
      hf-file = "Qwen3.6-35B-A3B-UD-IQ3_XXS.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      n-cpu-moe = 24;
      batch-size = 1024;
      ubatch-size = 512;
      temp = "0.6";
      top-p = "0.95";
      top-k = 20;
    } // lowVramMoE;

    qwen3_5-9b-fast-reasoning = {
      alias = "Qwen3.5 [Fast Reasoning 9B total]";
      hf-repo = "bartowski/Qwen_Qwen3.5-9B-GGUF";
      hf-file = "Qwen_Qwen3.5-9B-Q4_K_M.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "0.7";
      top-p = "0.9";
    } // hybridCuda;

    phi4-reasoning-14b-debugging = {
      alias = "Phi-4 Reasoning [Algorithms 14B total]";
      hf-repo = "Mungert/Phi-4-reasoning-GGUF";
      hf-file = "Phi-4-reasoning-q4_k.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "0.3";
      top-p = "0.9";
    } // hybridCuda;

    falcon-h1r-7b-fast-reasoning = {
      alias = "Falcon H1R [Fast Reasoning 7B total]";
      hf-repo = "tiiuae/Falcon-H1R-7B-GGUF";
      hf-file = "Falcon-H1R-7B-Q6_K.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "0.6";
      top-p = "0.95";
    } // hybridCuda;

    gemma4-12b-general-reasoning = {
      alias = "Gemma 4 IT [General Reasoning 12B total]";
      hf-repo = "prithivMLmods/gemma-4-12B-it-GGUF";
      hf-file = "gemma-4-12B-it.Q4_K_M.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "1.0";
      top-p = "0.95";
      top-k = 64;
    } // hybridCuda;

    magistral-small-24b-deliberate-reasoning = {
      alias = "Magistral Small [Deliberate Reasoning 24B total]";
      hf-repo = "bartowski/mistralai_Magistral-Small-2507-GGUF";
      hf-file = "mistralai_Magistral-Small-2507-IQ3_XXS.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "0.7";
      top-p = "0.95";
    } // hybridCuda;

    granite4-h-small-tools = {
      alias = "Granite 4 H Small [Tools/RAG 32B total 9B active]";
      hf-repo = "bartowski/ibm-granite_granite-4.0-h-small-GGUF";
      hf-file = "ibm-granite_granite-4.0-h-small-Q3_K_M.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "0.2";
      top-p = "0.9";
    } // lowVramMoE;

    nemotron3-nano-30b-a3b-agentic-reasoning = {
      alias = "Nemotron 3 Nano [Agentic Reasoning 30B total 3B active]";
      hf-repo = "noctrex/Nemotron-3-Nano-30B-A3B-MXFP4_MOE-GGUF";
      hf-file = "NVIDIA-Nemotron-3-Nano-30B-A3B-MXFP4_MOE.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      n-cpu-moe = 999;
      temp = "0.6";
      top-p = "0.95";
    } // lowVramMoE;

    deepseek-coder-v2-lite-agent = {
      alias = "DeepSeek Coder V2 Lite [Coding Agent 16B total 2.4B active]";
      hf-repo = "CISCai/DeepSeek-Coder-V2-Lite-Instruct-SOTA-GGUF";
      hf-file = "DeepSeek-Coder-V2-Lite-Instruct.IQ3_M.gguf";
      ctx-size = 8192;
      n-predict = 4096;
      temp = "0.2";
      top-p = "0.9";
    } // hybridCuda;

    qwen2_5-coder-1_5b-base-completion = {
      alias = "Qwen2.5 Coder Base [Inline Completion 1.5B total]";
      hf-repo = "tensorblock/Qwen2.5-Coder-1.5B-GGUF";
      hf-file = "Qwen2.5-Coder-1.5B-Q4_K_M.gguf";
      ctx-size = 8192;
      n-predict = 1024;
      temp = "0.2";
      top-p = "0.9";
    } // cudaFast;

    qwen2_5-coder-3b-instruct-implementation = {
      alias = "Qwen2.5 Coder Instruct [Implementation 3B total]";
      hf-repo = "Qwen/Qwen2.5-Coder-3B-Instruct-GGUF";
      hf-file = "qwen2.5-coder-3b-instruct-q4_k_m.gguf";
      ctx-size = 16384;
      n-predict = 2048;
      temp = "0.2";
      top-p = "0.9";
    } // cudaFast;

    qwen2_5-coder-3b-base-completion = {
      alias = "Qwen2.5 Coder Base [Inline Completion 3B total]";
      hf-repo = "bartowski/Qwen2.5-Coder-3B-GGUF";
      hf-file = "Qwen2.5-Coder-3B-Q4_K_M.gguf";
      ctx-size = 8192;
      n-predict = 1024;
      temp = "0.2";
      top-p = "0.9";
    } // cudaFast;

    qwen2_5-coder-1_5b-general = qwenCoder1_5bInstruct "General";
  }
  // toolchainSlms
